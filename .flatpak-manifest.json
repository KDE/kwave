{
    "id": "org.kde.kwave",
    "runtime": "org.kde.Platform",
    "runtime-version": "6.11",
    "sdk": "org.kde.Sdk",
    "command": "kwave",
    "desktop-file-name-suffix": " (Nightly)",
    "finish-args": [
        "--device=dri",
        "--share=ipc",
        "--socket=fallback-x11",
        "--socket=pulseaudio",
        "--socket=wayland",
        "--system-talk-name=org.freedesktop.UDisks2"
    ],
    "cleanup": [
        "/include",
        "/lib/cmake",
        "/lib/pkgconfig",
        "/share/man",
        "*.la",
        "*.a"
    ],
    "modules": [
        {
            "name": "libaudiofile",
            "buildsystem": "autotools",
            "config-opts": [
                "--disable-docs",
                "--disable-examples"
            ],
            "sources": [
                {
                    "type": "git",
                    "url": "https://github.com/mpruett/audiofile",
                    "commit": "b62c902dd258125cac86cd2df21fc898035a43d3"
                }
            ],
            "cleanup": [
                "/bin"
            ]
        },
        {
            "name": "libmad",
            "buildsystem": "cmake-ninja",
            "sources": [
                {
                    "type": "git",
                    "url": "https://codeberg.org/tenacityteam/libmad.git",
                    "commit": "9aa591f6a9d09fd2fdc45a73f89980c57d832ccf"
                }
            ]
        },
        {
            "name": "taglib",
            "buildsystem": "cmake-ninja",
            "config-opts": [
                "-DBUILD_SHARED_LIBS=ON",
                "-DCMAKE_BUILD_TYPE=Release"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://taglib.github.io/releases/taglib-2.0.2.tar.gz",
                    "sha256": "0de288d7fe34ba133199fd8512f19cc1100196826eafcb67a33b224ec3a59737"
                }
            ]
        },
        {
            "name": "kwave",
            "buildsystem": "cmake-ninja",
            "config-opts": [
                "-DCMAKE_BUILD_TYPE=RelWithDebInfo"
            ],
            "builddir": true,
            "sources": [
                {
                    "type": "dir",
                    "path": "."
                }
            ]
        }
    ]
}
