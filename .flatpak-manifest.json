{
    "id": "org.kde.kwave",
    "runtime": "org.kde.Platform",
    "runtime-version": "6.11",
    "sdk": "org.kde.Sdk",
    "command": "kwave",
    "desktop-file-name-suffix": " (Nightly)",
    "finish-args": [
        "--device=dri",
        "--share=ipc",
        "--socket=fallback-x11",
        "--socket=pulseaudio",
        "--socket=wayland",
        "--system-talk-name=org.freedesktop.UDisks2"
    ],
    "cleanup": [
        "/include",
        "/lib/cmake",
        "/lib/pkgconfig",
        "/share/man",
        "*.la",
        "*.a"
    ],
    "modules": [
        {
            "name": "libaudiofile",
            "buildsystem": "autotools",
            "config-opts": [
                "--disable-docs",
                "--disable-examples"
            ],
            "sources": [
                {
                    "type": "git",
                    "url": "https://github.com/mpruett/audiofile",
                    "commit": "b62c902dd258125cac86cd2df21fc898035a43d3"
                }
            ],
            "cleanup": [
                "/bin"
            ]
        },
        {
            "name": "libmad",
            "buildsystem": "cmake-ninja",
            "sources": [
                {
                    "type": "git",
                    "url": "https://codeberg.org/tenacityteam/libmad.git",
                    "commit": "9aa591f6a9d09fd2fdc45a73f89980c57d832ccf"
                }
            ]
        },
        {
            "name": "taglib",
            "buildsystem": "cmake-ninja",
            "config-opts": [
                "-DBUILD_BINDINGS=OFF",
                "-DBUILD_TESTING=OFF",
                "-DBUILD_SHARED_LIBS=ON",
                "-DCMAKE_BUILD_TYPE=Release"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://github.com/taglib/taglib/releases/download/v2.3.1/taglib-2.3.1.tar.gz",
                    "sha256": "a19d90e6fd41d09a0281ec0fe762d51491d7a6ccffc923c4f7868c5e647ca230",
                    "x-checker-data": {
                        "type": "anitya",
                        "project-id": 1982,
                        "stable-only": true,
                        "url-template": "https://github.com/taglib/taglib/releases/download/v$version/taglib-$version.tar.gz"
                    }
                }
            ],
            "cleanup": [
                "/bin",
                "/share/utf8cpp/cmake/"
            ]
        },
        {
            "name": "kwave",
            "buildsystem": "cmake-ninja",
            "config-opts": [
                "-DWITH_DOC=OFF",
                "-DBUILD_TESTING=OFF",
                "-DCMAKE_BUILD_TYPE=RelWithDebInfo"
            ],
            "builddir": true,
            "sources": [
                {
                    "type": "dir",
                    "path": "."
                }
            ]
        }
    ]
}
